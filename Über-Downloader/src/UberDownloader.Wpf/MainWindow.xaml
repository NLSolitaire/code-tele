<Window x:Class="UberDownloader.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:UberDownloader.Wpf.Controls"
        xmlns:views="clr-namespace:UberDownloader.Wpf.Views"
        xmlns:models="clr-namespace:UberDownloader.Core.Data;assembly=UberDownloader.Core"
        mc:Ignorable="d"
        Title="{Binding Loc[AppTitle]}" Icon="Assets/Uber.ico" Height="650" Width="650" MinHeight="600" MinWidth="625"
        Background="{DynamicResource WindowBackgroundBrush}" WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- VUE PRINCIPALE DES TÉLÉCHARGEMENTS -->
        <Grid x:Name="MainDownloadsView" Margin="14">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="18" Foreground="#3B82F6" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Loc[AppTitle]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding Loc[SettingsLogsButton]}" Command="{Binding OpenSettingsCommand}" Cursor="Hand"
                            Background="{DynamicResource CardBackgroundBrush}" Foreground="#38BDF8" BorderThickness="0" Padding="10,5" Margin="0,0,6,0" FontWeight="SemiBold" FontSize="11"/>
                    <Button Content="{Binding Loc[FloatingBarButton]}" Click="OnFloatingBarClicked" Cursor="Hand"
                            Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Padding="8,5" Margin="0,0,6,0" FontSize="11"/>
                    <Button Content="{Binding Loc[KofiButton]}"
                            ToolTip="{Binding Loc[KofiTooltip]}"
                            Command="{Binding OpenKofiCommand}"
                            Cursor="Hand" Background="#FF5E5B" Foreground="White" BorderThickness="0" Padding="10,5" FontWeight="Bold" FontSize="11">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Zone d'Ajout & Bannière de Feedback Positif -->
            <StackPanel Grid.Row="1">
                <!-- Bannière de notification succès (ex: flux média extrait avec succès) -->
                <Border Visibility="{Binding IsSuccessNotificationVisible, Converter={StaticResource BoolToVis}}"
                        Background="#064E3B" BorderBrush="#059669" BorderThickness="1.5"
                        CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🎉" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SuccessNotificationTitle}" Foreground="#A7F3D0" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Text="{Binding SuccessNotificationMessage}" Foreground="#6EE7B7" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="✕" Command="{Binding DismissSuccessNotificationCommand}" Cursor="Hand"
                                Background="Transparent" Foreground="#A7F3D0" BorderThickness="0"
                                Padding="8,4" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Grid>
                </Border>

                <!-- Zone d'Ajout (URL, Niveau 1 Dynamique Audio/Vidéo) -->
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                    <!-- Ligne 1 : Input URL + Bouton Télécharger -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <TextBox x:Name="UrlBox" Text="{Binding InputUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Height="34" Padding="10,0" VerticalContentAlignment="Center"
                                     Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushColor}" FontSize="12"/>
                            <TextBlock Text="{Binding Loc[InspectPlaceholder]}"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=UrlBox, Path=Text}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button Grid.Column="1" Content="{Binding Loc[StartDownload]}" Command="{Binding StartDownloadCommand}" Cursor="Hand"
                                Width="110" Height="34" Margin="8,0,0,0"
                                Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" FontSize="12"/>
                    </Grid>

                    <!-- Ligne 2 : Sélecteur de Mode Niveau 1 (Vidéo vs Audio) & Titre optionnel -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Bascule Vidéo / Audio -->
                        <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="6" Padding="2" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding Loc[ModeVideo]}" Command="{Binding SelectVideoModeCommand}" Cursor="Hand" Padding="10,4" BorderThickness="0" FontWeight="SemiBold" FontSize="11">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVideoMode}" Value="True">
                                                    <Setter Property="Background" Value="#2563EB"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="{Binding Loc[ModeAudio]}" Command="{Binding SelectAudioModeCommand}" Cursor="Hand" Padding="10,4" BorderThickness="0" FontWeight="SemiBold" FontSize="11">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAudioMode}" Value="True">
                                                    <Setter Property="Background" Value="#2563EB"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Titre personnalisé (optionnel) -->
                        <Grid Grid.Column="1" Margin="8,0">
                            <TextBox x:Name="TitleBox" Text="{Binding CustomTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30" Padding="8,0" VerticalContentAlignment="Center"
                                     Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushColor}" FontSize="11"/>
                            <TextBlock Text="{Binding Loc[CustomTitlePlaceholder]}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=TitleBox, Path=Text}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Indicateur d'inspection -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding InspectionStatusText}" Foreground="#F59E0B" FontWeight="SemiBold" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <Button Content="{Binding Loc[AdvancedSettings]}" Command="{Binding ToggleAdvancedCommand}"
                                    Background="{DynamicResource BadgeButtonBackgroundBrush}" Foreground="{DynamicResource BadgeButtonForegroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                                    Padding="10,5" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Ligne 3 : Options NIVEAU 1 adaptées selon Audio ou Vidéo -->
                    <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="6" Padding="8" Margin="0,8,0,0" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                        <Grid>
                            <!-- NIVEAU 1 VIDÉO -->
                            <Grid Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Résolution -->
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Loc[VideoResolution]}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding AvailableResolutions}" SelectedItem="{Binding SelectedResolution}" Height="28"/>
                                </StackPanel>

                                <!-- Langue audio (Cases à cocher multiples) -->
                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Loc[AudioLanguage]}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,3"/>
                                    <Grid>
                                        <ToggleButton x:Name="AudioDropDownToggle"
                                                      IsChecked="{Binding IsAudioDropDownOpen, Mode=TwoWay}"
                                                      Height="28" Cursor="Hand">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding SelectedAudioSummary}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="▼" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="8" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <Popup IsOpen="{Binding IsAudioDropDownOpen, Mode=TwoWay}"
                                               PlacementTarget="{Binding ElementName=AudioDropDownToggle}"
                                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Placement="Bottom">
                                            <Border Background="{DynamicResource DropDownBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Width="220" MaxHeight="220" Padding="8" Margin="0,2,0,0">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <StackPanel>
                                                        <CheckBox Content="{Binding Loc[SelectAll]}" IsChecked="{Binding IsAllAudioSelected, Mode=TwoWay}"
                                                                  Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6" Cursor="Hand"/>
                                                        <Border Height="1" Background="{DynamicResource BorderBrushColor}" Margin="0,0,0,6"/>
                                                        <ItemsControl ItemsSource="{Binding AudioTracks}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3" Cursor="Hand"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </StackPanel>

                                <!-- Sous-titres (Cases à cocher multiples) -->
                                <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Loc[Subtitles]}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,3"/>
                                    <Grid>
                                        <ToggleButton x:Name="SubtitlesDropDownToggle"
                                                      IsChecked="{Binding IsSubtitlesDropDownOpen, Mode=TwoWay}"
                                                      Height="28" Cursor="Hand">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding SelectedSubtitlesSummary}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="▼" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="8" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <Popup IsOpen="{Binding IsSubtitlesDropDownOpen, Mode=TwoWay}"
                                               PlacementTarget="{Binding ElementName=SubtitlesDropDownToggle}"
                                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Placement="Bottom">
                                            <Border Background="{DynamicResource DropDownBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Width="240" MaxHeight="240" Padding="8" Margin="0,2,0,0">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <StackPanel>
                                                        <CheckBox Content="{Binding Loc[SelectAll]}" IsChecked="{Binding IsAllSubtitlesSelected, Mode=TwoWay}"
                                                                  Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6" Cursor="Hand"/>
                                                        <CheckBox Content="{Binding Loc[EmbedInVideo]}" IsChecked="{Binding EmbedSubtitles, Mode=TwoWay}"
                                                                  Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,6" Cursor="Hand"/>
                                                        <Border Height="1" Background="{DynamicResource BorderBrushColor}" Margin="0,0,0,6"/>
                                                        <ItemsControl ItemsSource="{Binding SubtitleTracks}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3" Cursor="Hand"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </StackPanel>

                                <!-- Taille estimée -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Bottom" Margin="2,0,0,1">
                                    <TextBlock Text="{Binding Loc[EstimatedSize]}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,3"/>
                                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4" Padding="8,4" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                                        <TextBlock Text="{Binding EstimatedSizeText}" Foreground="#10B981" FontWeight="Bold" FontSize="11"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- NIVEAU 1 AUDIO -->
                            <Grid Visibility="{Binding IsAudioMode, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Profils Audio Niveau 1 -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Loc[AudioProfiles]}" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding AudioTierOptions}" SelectedItem="{Binding SelectedAudioTier}" Height="28"/>
                                </StackPanel>

                                <!-- Taille estimée -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="2,0,0,1">
                                    <TextBlock Text="{Binding Loc[EstimatedSize]}" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,3"/>
                                    <Border Background="#1E293B" CornerRadius="4" Padding="8,4" BorderBrush="#334155" BorderThickness="1">
                                        <TextBlock Text="{Binding EstimatedSizeText}" Foreground="#10B981" FontWeight="Bold" FontSize="11"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Accordéon Niveau 2 : Paramètres avancés spécifiques à ce téléchargement -->
                    <Border Margin="0,8,0,0" Padding="10" Background="#111827" CornerRadius="6" BorderBrush="#1F2937" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdvancedOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <!-- Mode Vidéo -->
                            <Grid Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Loc[Container]}" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding AvailableContainersList}" SelectedItem="{Binding ItemContainer}" Height="28"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Loc[VideoCodec]}" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding AvailableVideoCodecsList}" SelectedItem="{Binding ItemVideoCodec}" Height="28"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Loc[FPS]}" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding AvailableVideoFpsList}" SelectedItem="{Binding ItemVideoFps}" Height="28"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Loc[DynamicRange]}" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding AvailableDynamicRangesList}" SelectedItem="{Binding ItemVideoDynamicRange}" Height="28"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{Binding Loc[SpeedLimitShort]}" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding AvailableItemSpeedLimits}" SelectedItem="{Binding ItemSpeedLimit}" Height="28"/>
                                </StackPanel>
                            </Grid>

                            <!-- Mode Audio -->
                            <Grid Visibility="{Binding IsAudioMode, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Loc[AudioCodec]}" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding AvailableAudioCodecsList}" SelectedItem="{Binding ItemAudioCodec}" Height="28"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Loc[AudioBitrate]}" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding AvailableAudioBitratesList}" SelectedItem="{Binding ItemAudioBitrate}" Height="28"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Loc[SampleRate]}" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding AvailableAudioSampleRatesList}" SelectedItem="{Binding ItemAudioSampleRate}" Height="28"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Loc[Channels]}" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding AvailableAudioChannelsList}" SelectedItem="{Binding ItemAudioChannels}" Height="28"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{Binding Loc[SpeedLimitShort]}" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding AvailableItemSpeedLimits}" SelectedItem="{Binding ItemSpeedLimit}" Height="28"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- 3. Barre d'outils : Filtres par date + Bouton "Vider la liste" à gauche de la recherche -->
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Boutons segmentés de date avec effet visuel actif -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Tous -->
                    <Button Content="{Binding Loc[FilterAll]}" Command="{Binding SetDateFilterCommand}" CommandParameter="All" Cursor="Hand" Margin="0,0,4,0" Padding="10,4" FontSize="11">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                        <Setter Property="Background" Value="#2563EB"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Aujourd'hui -->
                    <Button Content="{Binding Loc[FilterToday]}" Command="{Binding SetDateFilterCommand}" CommandParameter="Today" Cursor="Hand" Margin="0,0,4,0" Padding="10,4" FontSize="11">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterToday}" Value="True">
                                        <Setter Property="Background" Value="#2563EB"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 7 derniers jours -->
                    <Button Content="{Binding Loc[FilterLast7Days]}" Command="{Binding SetDateFilterCommand}" CommandParameter="Last7Days" Cursor="Hand" Margin="0,0,4,0" Padding="10,4" FontSize="11">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterLast7Days}" Value="True">
                                        <Setter Property="Background" Value="#2563EB"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Ce mois-ci -->
                    <Button Content="{Binding Loc[FilterThisMonth]}" Command="{Binding SetDateFilterCommand}" CommandParameter="ThisMonth" Cursor="Hand" Padding="10,4" FontSize="11">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterThisMonth}" Value="True">
                                        <Setter Property="Background" Value="#2563EB"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Bouton Calendrier pour choisir une date précise -->
                    <Grid Margin="4,0,0,0">
                        <ToggleButton x:Name="CalendarToggle" Cursor="Hand" Padding="8,4" FontSize="11" ToolTip="{Binding Loc[PickDateTooltip]}"
                                      IsChecked="{Binding IsCalendarOpen, Mode=TwoWay}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="📅" FontSize="11" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding SpecificDateDisplayText}" Margin="4,0,0,0" FontSize="11" FontWeight="Bold"
                                                                   Visibility="{Binding IsFilterSpecificDate, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterSpecificDate}" Value="True">
                                            <Setter Property="Background" Value="#2563EB"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#3B82F6"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#3B82F6"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>

                        <Popup IsOpen="{Binding IsCalendarOpen, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=CalendarToggle}"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Placement="Bottom">
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,4,0,0">
                                <StackPanel>
                                    <Calendar x:Name="SpecificDatePicker" SelectionMode="SingleDate"
                                              SelectedDate="{Binding SelectedSpecificDate, Mode=TwoWay}"/>
                                    <Button Content="{Binding Loc[ClearFilter]}" Command="{Binding ClearSpecificDateCommand}"
                                            Cursor="Hand" Height="26" Margin="0,6,0,0" Background="#334155" Foreground="White" BorderThickness="0" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <!-- Droite : Bouton "Vider la liste" suivi du champ de recherche -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Bouton Vider la liste avec ToolTip explicatif -->
                    <Button Content="{Binding Loc[ClearListButton]}"
                            ToolTip="{Binding Loc[ClearListTooltip]}"
                            Command="{Binding ClearListCommand}"
                            Cursor="Hand"
                            Background="{DynamicResource CardBackgroundBrush}" Foreground="#EF4444" BorderThickness="0" Padding="8,4" Margin="0,0,8,0" FontWeight="SemiBold" FontSize="11"/>

                    <!-- Barre de recherche -->
                    <Grid Width="160">
                        <TextBox x:Name="SearchBox" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Height="28" Padding="6,0" VerticalContentAlignment="Center"
                                 Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushColor}" FontSize="11"/>
                        <TextBlock Text="{Binding Loc[SearchPlaceholder]}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=SearchBox, Path=Text}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- 4. Liste des Cartes avec ScrollBar visible, Ligne blanche séparatrice de Date & Placeholder gris si vide -->
            <Grid Grid.Row="3">
                <!-- Placeholder en gris quand la liste est vide -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,30,0,0"
                            Visibility="{Binding HasNoCards, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="📥" FontSize="36" HorizontalAlignment="Center" Opacity="0.3" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Loc[EmptyListTitle]}" Foreground="#64748B" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Loc[EmptyListSubtitle]}" Foreground="#475569" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- ScrollViewer contenant les cartes avec vitesse de défilement modérée -->
                <ScrollViewer x:Name="CardsScrollViewer" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="OnCardsScrollViewerPreviewMouseWheel">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Cards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <!-- Petite ligne blanche séparatrice avec la date centrée -->
                                        <Grid Visibility="{Binding ShowDateSeparator, Converter={StaticResource BoolToVis}}" Margin="0,10,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Height="1" Background="#FFFFFF" Opacity="0.25" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="10,2" BorderBrush="#334155" BorderThickness="1">
                                                <TextBlock Text="{Binding DateHeader}" Foreground="#E2E8F0" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Column="2" Height="1" Background="#FFFFFF" Opacity="0.25" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </Grid>

                                        <!-- Carte de téléchargement -->
                                        <controls:JobCardControl Margin="0,0,0,6"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Bouton "Montrer Plus" pour charger les 20 fichiers suivants -->
                        <Button Content="{Binding Loc[ShowMoreButton]}" Command="{Binding LoadMoreCommand}"
                                Visibility="{Binding HasMoreItems, Converter={StaticResource BoolToVis}}"
                                Cursor="Hand" HorizontalAlignment="Center" Margin="0,10,0,20" Padding="20,7"
                                Background="{DynamicResource CardBackgroundBrush}" Foreground="#38BDF8"
                                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                                FontWeight="SemiBold" FontSize="12">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- VUE DES PARAMÈTRES & LOGS (SWITCH FLUIDE) -->
        <views:SettingsView x:Name="SettingsControl" DataContext="{Binding SettingsVm}">
            <views:SettingsView.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsSettingsOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:SettingsView.Style>
        </views:SettingsView>

        <!-- VUE DE PRÉPARATION DE PLAYLIST -->
        <views:PlaylistPreparationView x:Name="PlaylistPrepControl" DataContext="{Binding PlaylistPrepVm}">
            <views:PlaylistPreparationView.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsPlaylistPrepOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:PlaylistPreparationView.Style>
        </views:PlaylistPreparationView>

        <!-- MODALE DE CONFIRMATION DE SORTIE (TÉLÉCHARGEMENTS ACTIFS) -->
        <Grid Visibility="{Binding IsExitConfirmOpen, Converter={StaticResource BoolToVis}}" Background="#B3000000">
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1.5"
                    CornerRadius="12" Padding="20" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="⚠️" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Loc[ExitDialogTitle]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding Loc[ExitDialogMessage]}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,18" LineHeight="18"/>

                    <StackPanel Margin="0,0,0,6">
                        <!-- Option 1 : Continuer en arrière-plan -->
                        <Button Content="{Binding Loc[ExitActionBackground]}" Command="{Binding ExitBackgroundCommand}" Cursor="Hand"
                                Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Height="36" Margin="0,0,0,8">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Option 2 : Mettre en pause & Quitter -->
                        <Button Content="{Binding Loc[ExitActionPauseAndQuit]}" Command="{Binding ExitPauseAndQuitCommand}" Cursor="Hand"
                                Background="#D97706" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Height="36" Margin="0,0,0,8">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Option 3 : Annuler & Quitter -->
                        <Button Content="{Binding Loc[ExitActionCancelAndQuit]}" Command="{Binding ExitCancelAndQuitCommand}" Cursor="Hand"
                                Background="#DC2626" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Height="36" Margin="0,0,0,8">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Option 4 : Rester dans l'application -->
                        <Button Content="{Binding Loc[ExitActionStay]}" Command="{Binding ExitStayCommand}" Cursor="Hand"
                                Background="{DynamicResource SubCardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" Height="34">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
